{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Codes Index Entry",
  "description": "一条车牌记录。一个番号一个文件，多人推荐时 recommendations 追加。",
  "type": "object",
  "required": ["code", "recommendations", "createdAt", "updatedAt"],
  "additionalProperties": false,
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[A-Z0-9]+(-[A-Z0-9]+)*$",
      "minLength": 3,
      "maxLength": 24,
      "description": "规范化后的番号，如 SSIS-123"
    },
    "title": { "type": "string", "maxLength": 120 },
    "actors": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "maxLength": 40 }
    },
    "tags": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "maxLength": 12 }
    },
    "studio": { "type": "string", "maxLength": 40 },
    "releaseDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "sourceUrl": { "type": "string", "maxLength": 300 },
    "score": { "type": "number", "minimum": 0, "maximum": 10 },
    "recommendations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["login", "reason", "at"],
        "additionalProperties": false,
        "properties": {
          "login": { "type": "string", "maxLength": 40 },
          "reason": { "type": "string", "minLength": 4, "maxLength": 200 },
          "score": { "type": "number", "minimum": 0, "maximum": 10 },
          "at": { "type": "string" }
        }
      }
    },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" }
  }
}
